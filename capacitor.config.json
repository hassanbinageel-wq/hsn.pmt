{
  "appId": "com.hsnpmt.app",
  "appName": "hsn.pmt",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#05111a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1100,
      "backgroundColor": "#05111a",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}